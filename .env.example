PORT=3000

# ── Redis connection ──────────────────────────────────────────────────────────
# Option 1: Full URL (Railway, Render, Heroku, etc.)
# REDIS_URL=redis://default:password@host:port

# Option 2: Individual vars (local dev, Docker Compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required for admin API access. Set to a long random string in production.
ADMIN_API_KEY=change-me

# When true, requests must include x-api-key header.
# Seeded demo keys: demo-free-key, demo-pro-key, demo-enterprise-key
REQUIRE_API_KEY=true
