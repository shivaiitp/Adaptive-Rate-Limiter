{
  "name": "rate-limiter",
  "version": "1.0.0",
  "description": "Adaptive Redis-backed token bucket rate limiter with tiered limits and an admin dashboard.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tests/core.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rate-limiter",
    "redis",
    "token-bucket",
    "express",
    "typescript"
  ],
  "author": "shivaiitp",
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
